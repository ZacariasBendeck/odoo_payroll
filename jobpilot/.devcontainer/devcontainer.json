{
  "name": "JobPilot",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/jobpilot",
  "postCreateCommand": "pip install -r requirements.txt && cp -n .env.example .env || true",
  "postStartCommand": "uvicorn app.main:app --host 0.0.0.0 --port 8000 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "JobPilot App",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
